{
  "name": "prompt-forge",
  "version": "2.5.0",
  "description": "一句话生成 NovelAI 生图提示词（danbooru 标签流 + UC 负向）。可手改、七类标签一键拼装、本地 NAI 整理与体检、历史与保存库全文检索、备份导入；纯本地、零运行时依赖。",
  "private": true,
  "type": "module",
  "main": "src/server.mjs",
  "license": "MIT",
  "keywords": [
    "image-prompt",
    "prompt-engineering",
    "text-to-image",
    "novelai",
    "danbooru",
    "nai",
    "llm",
    "openai-compatible",
    "local-first"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node tests/run-regression.mjs",
    "test:server": "node --test tests/server-unit.test.mjs",
    "test:static": "node tests/check-ids.mjs && node tests/check-prompts.mjs && node tests/check-jailbreak.mjs && node tests/check-themes.mjs && node tests/check-ideas.mjs",
    "test:contrast": "node tests/check-contrast-dom.mjs",
    "build:exe": "node build/build-exe.mjs",
    "build:desktop": "node build/build-desktop.mjs",
    "build:all": "node build/build-exe.mjs && node build/build-desktop.mjs",
    "sign": "node build/sign.mjs",
    "test:saved": "node tests/check-world-save.mjs"
  }
}
